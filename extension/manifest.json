{
  "manifest_version": 3,
  "name": "강의 한국어 더빙",
  "version": "0.12.8",
  "description": "Codex로 유튜브 강의 자막을 번역하고 한국어 음성으로 재생합니다.",
  "key": "MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE6Vsyxm0j1JaEaFEQhKU1gCnpVp5nbCL/UWwgkJFZcFJGFc0vK3//D/OklO9PSPrtrv0xDgTfxMFAe0dVOSPcxg==",
  "permissions": [
    "nativeMessaging",
    "tts",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "caption-source.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "cues.js",
        "player.js"
      ]
    }
  ],
  "minimum_chrome_version": "116",
  "optional_host_permissions": [
    "https://office.example/*"
  ]
}
